<!-- Replan normally; return failure to caller, no blind spin/backup recovery. -->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <PipelineSequence name="NavigateWithReplanning">
      <RateController hz="0.333">
        <ComputePathThroughPoses goals="{goals}" path="{path}" planner_id="GridBased"/>
      </RateController>
      <FollowPath path="{path}" controller_id="StationPath" goal_checker_id="general_goal_checker"/>
    </PipelineSequence>
  </BehaviorTree>
</root>
