Arguments (pass arguments as '<name>:=<value>'):

    'performance_config_file':
        no description given
        (default: PathJoinSubstitution('FindPackageShare(pkg='aruco_localizer'), 'config', 'performance.yaml''))

    'use_sim':
        Start robot in Gazebo simulation.
        (default: 'false')

    'start_robot':
        Start the TurtleBot3 base, arm controllers, and lidar.
        (default: 'true')

    'start_realsense':
        Start the RealSense camera and 3D target processing.
        (default: 'true')

    'start_segmentation':
        Start the legacy YOLO and EfficientTAM tracker.
        (default: 'false')

    'start_cleanup_perception':
        Start request-driven YOLO/depth station perception.
        (default: 'true')

    'start_cleanup_planner':
        Start constrained Gemini cleanup planning.
        (default: 'true')

    'start_navigation':
        Start ArUco localization and the Nav2 stack.
        (default: 'true')

    'start_pick_and_place':
        Start the service-controlled pick-and-place node.
        (default: 'true')

    'start_cleanup_manager':
        Start the high-level cleanup mission state machine.
        (default: 'true')

    'use_fake_hardware':
        Use fake ros2_control hardware for the base and arm.
        (default: 'false')

    'spin_command_scale':
        Turn multiplier; keep 1.0 with encoder feedback odometry.
        (default: '1.0')

    'cleanup_model_path':
        YOLO weights used by request-driven cleanup perception.
        (default: '/home/user/turtlebot3_ws/src/segmentation/best.pt')

    'cleanup_sam_model_path':
        SAM2 weights used for confirmed-object depth refinement.
        (default: '/home/user/turtlebot3_ws/src/segmentation/sam2_t.pt')

    'cleanup_camera_calibration_file':
        Perception-only camera extrinsics; nominal global TF remains unchanged.
        (default: PathJoinSubstitution('FindPackageShare(pkg='cleanup_perception'), 'config', 'grasp_camera_20260906.yaml''))

    'gemini_model':
        Gemini model used for bounded task planning.
        (default: 'gemini-3.5-flash-lite')

    'gemini_env_file':
        Local dotenv file containing GEMINI_API_KEY.
        (default: '/home/user/turtlebot3_ws/.env')

    'record_grasp_video':
        Save approach/grasp video only for selected objects.
        (default: 'true')

    'camera_name':
        camera unique name
        (default: 'camera')

    'camera_namespace':
        namespace for camera
        (default: 'camera')

    'serial_no':
        choose device by serial number
        (default: '''')

    'usb_port_id':
        choose device by usb port id
        (default: '''')

    'device_type':
        choose device by type
        (default: '''')

    'config_file':
        yaml config file
        (default: '''')

    'json_file_path':
        allows advanced configuration
        (default: '''')

    'initial_reset':
        ''
        (default: 'false')

    'accelerate_gpu_with_glsl':
        enable GPU acceleration with GLSL
        (default: 'false')

    'rosbag_filename':
        A realsense bagfile to run from as a device
        (default: '''')

    'rosbag_loop':
        Enable loop playback when playing a bagfile
        (default: 'false')

    'log_level':
        debug log level [DEBUG|INFO|WARN|ERROR|FATAL]
        (default: 'info')

    'output':
        pipe node output [screen|log]
        (default: 'screen')

    'enable_color':
        enable color stream
        (default: 'true')

    'rgb_camera.color_profile':
        color stream profile
        (default: '0,0,0')

    'rgb_camera.color_format':
        color stream format
        (default: 'RGB8')

    'rgb_camera.enable_auto_exposure':
        enable/disable auto exposure for color image
        (default: 'true')

    'enable_depth':
        enable depth stream
        (default: 'true')

    'enable_infra':
        enable infra0 stream
        (default: 'false')

    'enable_infra1':
        enable infra1 stream
        (default: 'false')

    'enable_infra2':
        enable infra2 stream
        (default: 'false')

    'depth_module.depth_profile':
        depth stream profile
        (default: '0,0,0')

    'depth_module.depth_format':
        depth stream format
        (default: 'Z16')

    'depth_module.infra_profile':
        infra streams (0/1/2) profile
        (default: '0,0,0')

    'depth_module.infra_format':
        infra0 stream format
        (default: 'RGB8')

    'depth_module.infra1_format':
        infra1 stream format
        (default: 'Y8')

    'depth_module.infra2_format':
        infra2 stream format
        (default: 'Y8')

    'depth_module.color_profile':
        Depth module color stream profile for d405
        (default: '0,0,0')

    'depth_module.color_format':
        color stream format for d405
        (default: 'RGB8')

    'depth_module.exposure':
        Depth module manual exposure value
        (default: '8500')

    'depth_module.gain':
        Depth module manual gain value
        (default: '16')

    'depth_module.hdr_enabled':
        Depth module hdr enablement flag. Used for hdr_merge filter
        (default: 'false')

    'depth_module.enable_auto_exposure':
        enable/disable auto exposure for depth image
        (default: 'true')

    'depth_module.exposure.1':
        Depth module first exposure value. Used for hdr_merge filter
        (default: '7500')

    'depth_module.gain.1':
        Depth module first gain value. Used for hdr_merge filter
        (default: '16')

    'depth_module.exposure.2':
        Depth module second exposure value. Used for hdr_merge filter
        (default: '1')

    'depth_module.gain.2':
        Depth module second gain value. Used for hdr_merge filter
        (default: '16')

    'enable_sync':
        'enable sync mode'
        (default: 'false')

    'depth_module.inter_cam_sync_mode':
        [0-Default, 1-Master, 2-Slave]
        (default: '0')

    'enable_rgbd':
        'enable rgbd topic'
        (default: 'false')

    'enable_gyro':
        'enable gyro stream'
        (default: 'false')

    'enable_accel':
        'enable accel stream'
        (default: 'false')

    'enable_motion':
        'enable motion stream (IMU) for DDS devices'
        (default: 'false')

    'gyro_fps':
        ''
        (default: '0')

    'accel_fps':
        ''
        (default: '0')

    'motion_fps':
        'motion stream samples per second'
        (default: '0')

    'unite_imu_method':
        [0-None, 1-copy, 2-linear_interpolation]
        (default: '0')

    'clip_distance':
        ''
        (default: '-2.')

    'angular_velocity_cov':
        ''
        (default: '0.01')

    'linear_accel_cov':
        ''
        (default: '0.01')

    'diagnostics_period':
        Rate of publishing diagnostics. 0=Disabled
        (default: '0.0')

    'publish_tf':
        [bool] enable/disable publishing static & dynamic TF
        (default: 'true')

    'tf_publish_rate':
        [double] rate in Hz for publishing dynamic TF
        (default: '0.0')

    'pointcloud.enable':
        
        (default: 'false')

    'pointcloud.stream_filter':
        texture stream for pointcloud
        (default: '2')

    'pointcloud.stream_index_filter':
        texture stream index for pointcloud
        (default: '0')

    'pointcloud.ordered_pc':
        
        (default: 'false')

    'pointcloud.allow_no_texture_points':
        ''
        (default: 'false')

    'align_depth.enable':
        enable align depth filter
        (default: 'false')

    'colorizer.enable':
        enable colorizer filter
        (default: 'false')

    'decimation_filter.enable':
        enable_decimation_filter
        (default: 'false')

    'rotation_filter.enable':
        enable rotation_filter
        (default: 'false')

    'rotation_filter.rotation':
        rotation value: 0.0, 90.0, -90.0, 180.0
        (default: '0.0')

    'spatial_filter.enable':
        enable_spatial_filter
        (default: 'false')

    'temporal_filter.enable':
        enable_temporal_filter
        (default: 'false')

    'disparity_filter.enable':
        enable_disparity_filter
        (default: 'false')

    'hole_filling_filter.enable':
        enable_hole_filling_filter
        (default: 'false')

    'hdr_merge.enable':
        hdr_merge filter enablement flag
        (default: 'false')

    'wait_for_device_timeout':
        Timeout for waiting for device to connect (Seconds)
        (default: '-1.')

    'reconnect_timeout':
        Timeout(seconds) between consequtive reconnection attempts
        (default: '6.')

    'base_frame_id':
        Root frame of the sensors transform tree
        (default: 'link')

    'tf_prefix':
        prefix to be prepended to all frame IDs
        (default: '')

    'decimation_filter.filter_magnitude':
        decimation filter magnitude
        (default: '2')

    'enable_safety':
        'enable safety stream'
        (default: 'false')

    'safety_camera.safety_mode':
        [int] 0-Run, 1-Standby, 2-Service
        (default: '0')

    'enable_labeled_point_cloud':
        'enable labeled point cloud stream'
        (default: 'false')

    'depth_mapping_camera.labeled_point_cloud_profile':
        'Label PointCloud stream profile'
        (default: '0,0,0')

    'enable_occupancy':
        'enable occupancy stream'
        (default: 'false')

    'depth_mapping_camera.occupancy_profile':
        'Occupancy stream profile'
        (default: '0,0,0')

    'debug_output_dir':
        Directory for per-run navigation logs and snapshots.
        (default: PathJoinSubstitution('EnvVar('HOME'), 'turtlebot3_ws', 'nav_debug''))

    'namespace':
        Top-level namespace
        (default: '')

    'use_sim_time':
        Use simulation (Gazebo) clock if true
        (default: 'false')

    'params_file':
        Full path to the ROS2 parameters file to use for all launched nodes
        (default: '/opt/ros/humble/share/nav2_bringup/params/nav2_params.yaml')

    'autostart':
        Automatically startup the nav2 stack
        (default: 'true')

    'use_composition':
        Use composed bringup if True
        (default: 'False')

    'container_name':
        the name of conatiner that nodes will load in if use composition
        (default: 'nav2_container')

    'use_respawn':
        Whether to respawn if a node crashes. Applied when composition is disabled.
        (default: 'False')
